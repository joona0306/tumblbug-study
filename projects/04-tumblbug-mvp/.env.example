# 이 파일을 복사해 .env.local 을 만들고 값을 채운다 (.env.local 은 git에 올라가지 않는다)
# cp .env.example .env.local

# Sentry (5주차) — 비워 두면 에러 모니터링이 꺼진 채로 동작한다
# Sentry → Settings → Projects → (프로젝트) → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=

# 소스맵 업로드용 (선택, Vercel 환경 변수에만 넣어도 된다)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# DB (6주차) — Neon → Connect → Database: tumblbug_dev, Connection pooling 켜기
# 복사한 주소의 sslmode=require 를 sslmode=verify-full 로 바꿔서 넣는다
DATABASE_URL=

# Better Auth (6주차) — 아래 명령으로 만든 무작위 글자
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob (7주차) — Vercel → Storage → Blob → .env.local 탭의 토큰
BLOB_READ_WRITE_TOKEN=

# 토스페이먼츠 (11주차) — 개발자센터 → API 키 → "결제위젯 연동 키" (반드시 test_ 로 시작하는 테스트 키)
# 클라이언트 키(test_gck_)는 브라우저에 공개돼도 되지만, 시크릿 키(test_gsk_)는 서버에만
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 예약 작업 (13주차) — /api/cron/daily 를 보호하는 비밀값. 아래 명령으로 만든 무작위 글자 (Vercel 환경 변수에도 같은 값)
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=
